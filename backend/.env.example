# Copy to backend/.env for local development.
DATABASE_URL=postgresql://payceylon:payceylon@localhost:5432/payceylon

# "development" makes the API trust the Firebase Auth emulator, which accepts unsigned tokens.
# Any other value (the default is "production") verifies real Firebase tokens and refuses to
# start if FIREBASE_AUTH_EMULATOR_HOST is set.
APP_ENV=development
FIREBASE_PROJECT_ID=demo-payceylon
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Production only: service account JSON, inline or as a file path.
FIREBASE_SERVICE_ACCOUNT_JSON=

CORS_ORIGINS=http://10.0.2.2:8080,http://localhost:8080
